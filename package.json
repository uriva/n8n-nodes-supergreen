{
  "name": "n8n-nodes-supergreen",
  "version": "0.1.4",
  "description": "n8n community node for Supergreen - Headless WhatsApp & Telegram automation API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "supergreen",
    "whatsapp",
    "telegram",
    "automation",
    "headless whatsapp",
    "wppconnect"
  ],
  "license": "MIT",
  "homepage": "https://supergreen.cc",
  "author": {
    "name": "Supergreen",
    "email": "uri@supergreen.cc",
    "url": "https://supergreen.cc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uriva/n8n-nodes-supergreen.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SupergreenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Supergreen/Supergreen.node.js",
      "dist/nodes/Supergreen/SupergreenTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/scan-community-package": "^0.34.0",
    "@types/node": "^26.4.1",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.9.0"
  }
}
