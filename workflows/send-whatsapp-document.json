        "toNumber": "={{ $('Extract Invoice and Customer Phone').item.json.cleanPhone }}",
        "type": "document",
        "mediaSource": "binary",
        "binaryPropertyName": "data",
        "additionalFields": {
          "filename": "={{ $('Extract Invoice and Customer Phone').item.json.invoiceNumber + '.pdf' }}",
          "caption": "=Hi {{ $('Extract Invoice and Customer Phone').item.json.customerName }}, thank you for your payment of {{ $('Extract Invoice and Customer Phone').item.json.amountFormatted }} to {{ $('Extract Invoice and Customer Phone').item.json.companyName }}! Attached is receipt {{ $('Extract Invoice and Customer Phone').item.json.invoiceNumber }}.",
          "mimeType": "application/pdf"
        }
      }
    },
