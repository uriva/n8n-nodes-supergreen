    {
      "id": "a6060006-6666-4666-8666-000000000022",
      "name": "Parse Dunning Poll Choice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        720
      ],
      "parameters": {
        "jsCode": "const ev = $('When Customer Votes on Dunning Poll').first().json;\nconst cfg = $('Configure Recovery Settings').first().json;\nconst idx = Array.isArray(ev.vote?.selectedOptionIndices) ? Number(ev.vote.selectedOptionIndices[0]) : -1;\nconst chatId = String(ev.chat?.id || '');\nconst cleanPhone = chatId.replace(/@.*$/, '').replace(/\\D/g, '');\nif (!cleanPhone || idx < 0 || idx > 2) return [];\n\nconst labels = ['Card Updated by Customer', 'Retry Requested in 3 Days', 'Billing Help Requested'];\nconst replies = [\n  'Thank you! Stripe will automatically confirm your updated payment method and send your PDF receipt shortly.',\n  'Got it — we noted your request and no service interruption will occur in the meantime.',\n  'A member of our billing team has been notified and will reply here shortly to help.',\n];\nreturn [{\n  json: {\n    chatId,\n    cleanPhone,\n    recoveryNote: labels[idx],\n    replyText: replies[idx],\n    needsFinanceHelp: idx === 2 && cfg.financeGroupChatId !== 'YOUR_FINANCE_GROUP_ID@g.us',\n    financeGroupChatId: cfg.financeGroupChatId,\n    spreadsheetId: cfg.spreadsheetId,\n  },\n}];"
      }
    },
