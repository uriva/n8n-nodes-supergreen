      },
      "parameters": {
        "resource": "poll",
        "operation": "sendPoll",
        "toNumber": "={{ $('Normalize Invoice and Phone').item.json.cleanPhone }}",
        "name": "Once you check your card, choose an option below:",
        "options": "Card updated - retry now, Remind me in 3 days, Talk to billing support"
      }
    },
    {
      "id": "b7070007-7777-4777-8777-000000000022",
      "name": "Prepare Past-Due Ledger Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        360
      ],
      "parameters": {
        "jsCode": "const inv = $('Normalize Invoice and Phone').first().json;\nconst portal = $('Create Stripe Billing Portal Session').first().json || {};\nconst pollRes = $input.first().json || {};\nconst pollMessageId = String(pollRes.messageId || pollRes.id || '');\nconst nextRetryAt = new Date(Date.now() + 72 * 3600 * 1000).toISOString();\nreturn [{\n  json: {\n    ...inv,\n    portalUrl: String(portal.url || inv.hostedInvoiceUrl || ''),\n    pollMessageId,\n    nextRetryAt,\n  },\n}];"
      }
    },
