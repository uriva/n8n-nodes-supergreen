      "name": "Configure Billing Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        240
      ],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "companyName",
              "value": "CloudPulse SaaS",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "spreadsheetId",
