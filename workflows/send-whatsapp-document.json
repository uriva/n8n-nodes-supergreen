    },
    {
      "id": "b7070007-7777-4777-8777-000000000032",
      "name": "Lookup Invoice by Poll Message ID",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        440,
        820
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets-cred",
          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "pollMessageId",
              "lookupValue": "={{ $('When Customer Votes on Dunning Poll').item.json.messageId }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b7070007-7777-4777-8777-000000000033",
      "name": "Validate Poll Choice and Invoice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        820
      ],
      "parameters": {
        "jsCode": "const row = $input.first()?.json;\nif (!row || !row.invoiceId || row.status === 'Paid' || row.status === 'Recovered') return [];\nconst ev = $('When Customer Votes on Dunning Poll').first().json;\nconst cfg = $('Vote Handler Configuration').first().json;\nconst idx = Array.isArray(ev.vote?.selectedOptionIndices) ? Number(ev.vote.selectedOptionIndices[0]) : -1;\nif (idx < 0 || idx > 2) return [];\nconst actions = ['retry_now', 'snooze_3d', 'support_escalation'];\nreturn [{\n  json: {\n    ...row,\n    chatId: String(ev.chat?.id || row.phone),\n    action: actions[idx],\n    snoozeUntilIso: new Date(Date.now() + 72 * 3600 * 1000).toISOString(),\n    spreadsheetId: cfg.spreadsheetId,\n    slackBillingChannelId: cfg.slackBillingChannelId,\n  },\n}];"
      }
    },
    {
      "id": "b7070007-7777-4777-8777-000000000034",
      "name": "Route Dunning Poll Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        880,
        820
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "act-retry",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "retry_now",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Retry Charge Now"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "act-snooze",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "snooze_3d",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Snooze 3 Days"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "act-support",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "support_escalation",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Billing Support"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b7070007-7777-4777-8777-000000000035",
      "name": "Retry Stripe Invoice Charge Now",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        680
      ],
      "onError": "continueRegularOutput",
      "credentials": {
