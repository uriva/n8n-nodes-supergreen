    {
      "id": "b7070007-7777-4777-8777-000000000013",
      "name": "Fetch Stripe Customer Profile",
      "type": "n8n-nodes-base.stripe",
      "typeVersion": 1,
      "position": [
        660,
        260
      ],
      "credentials": {
        "stripeApi": {
          "id": "stripe-cred",
          "name": "Stripe API"
        }
