    {
      "id": "a6060006-6666-4666-8666-000000000012",
      "name": "Extract Invoice and Customer Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        240
      ],
      "parameters": {
        "jsCode": "const ev = $('On Stripe Invoice Event').first().json;\nconst cfg = $('Configure Billing Settings').first().json;\nconst inv = ev.data?.object || {};\nconst rawPhone = String(inv.customer_phone || inv.metadata?.whatsapp || '').trim();\nconst cleanPhone = rawPhone.replace(/\\D/g, '');\nif (cleanPhone.length < 8) return [];\n\nconst cents = Number(inv.amount_paid || inv.amount_due || 0);\nconst currency = String(inv.currency || 'usd').toUpperCase();\nconst amountFormatted = `${(cents / 100).toFixed(2)} ${currency}`;\nconst invoiceNumber = String(inv.number || inv.id || 'Invoice').replace(/[^a-zA-Z0-9._-]/g, '-');\n\nreturn [{\n  json: {\n    eventType: String(ev.type || ''),\n    invoiceId: String(inv.id || invoiceNumber),\n    invoiceNumber,\n    cleanPhone,\n    customerName: String(inv.customer_name || 'there').trim(),\n    amountFormatted,\n    invoicePdfUrl: String(inv.invoice_pdf || ''),\n    hostedInvoiceUrl: String(inv.hosted_invoice_url || ''),\n    companyName: cfg.companyName,\n    spreadsheetId: cfg.spreadsheetId,\n  },\n}];"
      }
    },
    {
