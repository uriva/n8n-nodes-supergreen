    {
      "id": "b7070007-7777-4777-8777-000000000014",
      "name": "Normalize Invoice and Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "jsCode": "const ev = $('On Stripe Invoice Event').first().json;\nconst cfg = $('Workflow Configuration').first().json;\nconst customer = $input.first().json || {};\nconst inv = ev.data?.object || {};\n\nconst rawPhone = String(\n  inv.customer_phone || customer.phone || customer.metadata?.whatsapp_phone || inv.metadata?.whatsapp_phone || ''\n).trim();\nconst cleanPhone = rawPhone.replace(/\\D/g, '');\nif (cleanPhone.length < 8) return [];\n\nconst cents = Number(inv.amount_paid || inv.amount_due || 0);\nconst currency = String(inv.currency || 'usd').toUpperCase();\nconst amountFormatted = `${(cents / 100).toFixed(2)} ${currency}`;\nconst invoiceNumber = String(inv.number || inv.id || 'Invoice').replace(/[^a-zA-Z0-9._-]/g, '-');\n\nreturn [{\n  json: {\n    eventType: String(ev.type || ''),\n    invoiceId: String(inv.id || ''),\n    invoiceNumber,\n    customerId: String(inv.customer || customer.id || ''),\n    cleanPhone,\n    customerName: String(customer.name || inv.customer_name || 'there').trim(),\n    amountFormatted,\n    invoicePdfUrl: String(inv.invoice_pdf || ''),\n    hostedInvoiceUrl: String(inv.hosted_invoice_url || ''),\n    companyName: cfg.companyName,\n    spreadsheetId: cfg.spreadsheetId,\n    portalReturnUrl: cfg.portalReturnUrl,\n    slackBillingChannelId: cfg.slackBillingChannelId,\n  },\n}];"
      }
    },
