    {
      "id": "b7070007-7777-4777-8777-000000000053",
      "name": "Filter Expired Snoozes Under Retry Cap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        1340
      ],
      "parameters": {
        "jsCode": "const now = Date.now();\nconst cfg = $('Sweep Configuration').first().json;\nreturn $input.all()\n  .map(i => i.json)\n  .filter(r => ['Past Due', 'Snoozed'].includes(String(r.status || '')))\n  .filter(r => Number(r.retryCount || 0) < 2)\n  .filter(r => r.nextRetryAt && Date.parse(String(r.nextRetryAt)) <= now)\n  .map(r => ({\n    json: {\n      ...r,\n      nextRetryCount: Number(r.retryCount || 0) + 1,\n      nextSnoozeIso: new Date(now + 72 * 3600 * 1000).toISOString(),\n      spreadsheetId: cfg.spreadsheetId,\n    },\n  }));"
      }
    },
