    {
      "id": "d7070007-7777-4777-8777-000000000043",
      "name": "Filter Pending Leads Past 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        2192
      ],
      "parameters": {
        "jsCode": "const cfg = $('Follow-Up Configuration').first().json || {};\nconst now = Date.now();\nconst due = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (!row || !row.leadId || !row.phone) continue;\n  if (row.qualification !== 'Pending' || row.nudgeSent === 'Yes') continue;\n  const dueMs = Date.parse(String(row.nudgeDueAt || ''));\n  if (Number.isFinite(dueMs) && dueMs <= now) {\n    due.push({ json: { ...row, companyBrand: cfg.companyBrand, spreadsheetId: cfg.spreadsheetId, bookingUrl: cfg.bookingUrl } });\n  }\n}\nreturn due;"
      }
    },
