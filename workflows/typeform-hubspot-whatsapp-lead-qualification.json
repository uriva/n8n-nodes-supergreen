    {
      "id": "d7070007-7777-4777-8777-000000000023",
      "name": "Score Qualification Vote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        1296
      ],
      "parameters": {
        "jsCode": "const row = $input.first()?.json;\nif (!row || !row.leadId || row.qualification !== 'Pending') return [];\nconst ev = $('When Lead Votes on Qualification Poll').first().json || {};\nconst cfg = $('Vote Routing Configuration').first().json || {};\nconst selected = ev.vote?.selectedOptionIndices;\nif (!Array.isArray(selected) || selected.length === 0) return [];\nconst idx = Number(selected[0]);\nif (idx < 0 || idx > 2) return [];\nconst tiers = ['hot', 'warm', 'nurture'];\nreturn [{\n  json: {\n    ...row,\n    chatId: String(ev.chat?.id || row.phone),\n    tier: tiers[idx],\n    companyBrand: cfg.companyBrand,\n    spreadsheetId: cfg.spreadsheetId,\n    slackSalesChannelId: cfg.slackSalesChannelId,\n    bookingUrl: cfg.bookingUrl,\n    guideUrl: cfg.guideUrl,\n  },\n}];"
      }
    },
    {
      "id": "d7070007-7777-4777-8777-000000000024",
      "name": "Route Lead Qualification Tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        928,
        1296
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "t-hot",
                    "leftValue": "={{ $json.tier }}",
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hot Lead"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
