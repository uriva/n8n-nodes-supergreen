    {
      "id": "d7070007-7777-4777-8777-000000000013",
      "name": "Normalize Lead and Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        624,
        368
      ],
      "parameters": {
        "jsCode": "const raw = $('On Typeform Lead Submitted').first().json || {};\nconst cfg = $('Lead Routing Configuration').first().json || {};\nconst answers = raw.form_response?.answers || raw;\nconst findField = (re) => {\n  for (const [k, v] of Object.entries(answers)) {\n    if (re.test(k) && v !== null && v !== undefined && String(v).trim()) return String(v).trim();\n  }\n  return '';\n};\nconst email = findField(/email/i);\nconst rawPhone = findField(/phone|whatsapp|mobile/i);\nconst cleanPhone = rawPhone.replace(/\\\\D/g, '');\nif (!email || cleanPhone.length < 8) return [];\nconst fullName = findField(/name/i) || 'there';\nconst parts = fullName.split(/\\\\s+/);\nconst firstName = parts[0] || 'there';\nconst lastName = parts.slice(1).join(' ');\nconst companyName = findField(/company|organization|business/i);\nconst useCase = findField(/need|goal|project|help|message/i);\nconst leadId = String(raw.form_response?.token || raw.event_id || cleanPhone);\nconst nudgeDueAt = new Date(Date.now() + Number(cfg.nudgeHours || 24) * 3600 * 1000).toISOString();\nreturn [{\n  json: {\n    leadId,\n    email,\n    firstName,\n    lastName,\n    fullName,\n    companyName,\n    useCase,\n    cleanPhone,\n    nudgeDueAt,\n    companyBrand: cfg.companyBrand,\n    spreadsheetId: cfg.spreadsheetId,\n    slackSalesChannelId: cfg.slackSalesChannelId,\n    bookingUrl: cfg.bookingUrl,\n    guideUrl: cfg.guideUrl,\n  },\n}];"
      }
    },
