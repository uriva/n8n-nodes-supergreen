    {
      "id": "c8080008-8888-4888-8888-000000000053",
      "name": "Build Aging Escalations Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        1140
      ],
      "parameters": {
        "jsCode": "const cutoff = Date.now() - 4 * 3600 * 1000;\nconst cfg = $('SLA Configuration').first().json;\nconst aging = $input.all()\n  .map(i => i.json)\n  .filter(r => ['Escalated', 'Human Assigned', 'Refund Review'].includes(String(r.status || '')))\n  .filter(r => !r.updatedAt || Date.parse(String(r.updatedAt)) <= cutoff);\nif (!aging.length) return [];\nconst lines = aging.slice(0, 10).map(r => `- ${r.senderName || r.phone} (+${r.phone}) [${r.status}]: ${r.summary || ''}`);\nreturn [{\n  json: {\n    supportGroupJid: cfg.supportGroupJid,\n    digestText: `Open WhatsApp escalations >4h (${aging.length}):\\n` + lines.join('\\n'),\n  },\n}];"
      }
    },
