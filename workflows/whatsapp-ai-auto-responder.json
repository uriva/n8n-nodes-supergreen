                    "id": "m-audio",
                    "leftValue": "={{ $('Evaluate Takeover and Detect Modality').item.json.modality }}",
                    "rightValue": "audio",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Voice Note"
            },
