    {
      "id": "c8080008-8888-4888-8888-000000000022",
      "name": "Assemble Unified Support Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        320
      ],
      "parameters": {
        "jsCode": "const meta = $('Evaluate Takeover and Detect Modality').first().json;\nconst cur = $input.first().json || {};\nlet customerPrompt = meta.text;\nif (meta.modality === 'audio') {\n  customerPrompt = `[Voice note transcript]: ${cur.text || ''}`;\n} else if (meta.modality === 'image') {\n  const analysis = cur.content || cur.text || JSON.stringify(cur);\n  customerPrompt = `[Customer sent photo. Caption: \"${meta.text || 'none'}\". Vision details: ${analysis}]`;\n}\nreturn [{ json: { ...meta, customerPrompt } }];"
      }
    },
    {
      "id": "c8080008-8888-4888-8888-000000000023",
      "name": "AI Support and Order Operations Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        2280,
        320
      ],
      "hasOutputParser": true,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Customer phone: ' + $json.cleanPhone + '\\nCustomer name: ' + $json.senderName + '\\nMessage (' + $json.modality + '): ' + $json.customerPrompt }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are the WhatsApp support & order operations specialist for {{ $json.businessName }}.\nRules:\n1. Always call `Search Support Policies` before answering policy, shipping, return, or warranty questions.\n2. Whenever a customer asks about an order, delivery, or item issue, call `Lookup Customer Orders` to inspect their orders.\n3. If a customer requests a return, replacement, or shipping-address update on a verified order, log it via `Log Return or Action Request`.\n4. Set `needsHumanEscalation: true` when an image shows physical damage, a refund dispute arises, no matching policy exists, or the customer asks for a person.\n5. Keep `reply` concise (under 90 words) and natural for WhatsApp."
        }
      }
    },
