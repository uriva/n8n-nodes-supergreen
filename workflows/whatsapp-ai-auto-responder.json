          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "={{ $('Build Unified Customer Prompt').item.json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Inquiries",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "phone": "={{ $('Build Unified Customer Prompt').item.json.cleanPhone }}",
            "senderName": "={{ $('Build Unified Customer Prompt').item.json.senderName }}",
            "modality": "={{ $('Build Unified Customer Prompt').item.json.modality }}",
            "category": "={{ $('Support and Triage AI Agent').item.json.output.category }}",
            "priority": "={{ $('Support and Triage AI Agent').item.json.output.priority }}",
            "summary": "={{ $('Support and Triage AI Agent').item.json.output.summary }}",
            "customerInput": "={{ $('Build Unified Customer Prompt').item.json.normalizedInput }}"
          }
        },
        "options": {}
      }
    },
    {
      "id": "f5050005-5555-4555-8555-000000000026",
      "name": "Requires Immediate Team Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2680,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-esc",
              "leftValue": "={{ $('Support and Triage AI Agent').item.json.output.category === 'human_escalation' && $('Build Unified Customer Prompt').item.json.escalationGroupChatId !== 'YOUR_TEAM_GROUP_ID@g.us' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f5050005-5555-4555-8555-000000000027",
      "name": "Alert Support Group on WhatsApp",
      "type": "n8n-nodes-supergreen.supergreen",
      "typeVersion": 1,
      "position": [
        2900,
        140
      ],
      "credentials": {
        "supergreenApi": {
          "id": "supergreen-cred",
          "name": "Supergreen API"
        }
      },
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toNumber": "={{ $('Build Unified Customer Prompt').item.json.escalationGroupChatId }}",
        "message": "=Urgent WhatsApp escalation ({{ $('Support and Triage AI Agent').item.json.output.priority }})\nCustomer: {{ $('Build Unified Customer Prompt').item.json.senderName }} (+{{ $('Build Unified Customer Prompt').item.json.cleanPhone }})\nSummary: {{ $('Support and Triage AI Agent').item.json.output.summary }}",
        "additionalFields": {}
      }
    }
