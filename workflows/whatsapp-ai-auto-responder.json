            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "is-actionable",
              "leftValue": "={{ ['sales_lead', 'human_escalation'].includes($('Support and Triage AI Agent').item.json.output.category) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
