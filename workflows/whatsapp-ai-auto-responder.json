    {
      "id": "c8080008-8888-4888-8888-000000000013",
      "name": "Check Existing Ticket State",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        260
      ],
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets-cred",
          "name": "Google Sheets OAuth2"
        }
      },
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $json.spreadsheetId }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Tickets",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "phone",
              "lookupValue": "={{ String($('When Customer Message Arrives').item.json.chat?.id || '').replace(/@.*$/, '') }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c8080008-8888-4888-8888-000000000014",
      "name": "Evaluate Takeover and Detect Modality",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        260
      ],
      "parameters": {
        "jsCode": "const ev = $('When Customer Message Arrives').first().json;\nconst cfg = $('Support Configuration').first().json;\nconst ticketRow = $input.first()?.json || {};\nconst chatId = String(ev.chat?.id || '');\nif (!chatId || chatId.endsWith('@g.us')) return [];\n\nconst attachments = Array.isArray(ev.attachments) ? ev.attachments : [];\nconst firstAtt = attachments[0] || null;\nconst mime = String(firstAtt?.mimeType || '').toLowerCase();\nconst fileUri = String(firstAtt?.fileUri || '');\nconst text = String(ev.text || firstAtt?.caption || '').trim();\n\nlet modality = 'text';\nif (fileUri && mime.startsWith('audio/')) modality = 'audio';\nelse if (fileUri && mime.startsWith('image/')) modality = 'image';\nif (modality === 'text' && !text) return [];\n\nreturn [{\n  json: {\n    chatId,\n    cleanPhone: chatId.replace(/@.*$/, ''),\n    senderName: String(ev.author?.username || ev.chat?.title || chatId.replace(/@.*$/, '')),\n    messageId: String(ev.messageId || ''),\n    modality,\n    text,\n    fileUri,\n    humanAssigned: String(ticketRow.status || '') === 'Human Assigned',\n    businessName: cfg.businessName,\n    spreadsheetId: cfg.spreadsheetId,\n    supportGroupJid: cfg.supportGroupJid,\n  },\n}];"
      }
    },
    {
