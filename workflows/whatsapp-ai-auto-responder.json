    {
      "id": "c8080008-8888-4888-8888-000000000043",
      "name": "Map Agent Poll Vote to Ticket Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        920
      ],
      "parameters": {
        "jsCode": "const ticket = $input.first()?.json;\nif (!ticket || !ticket.phone) return [];\nconst ev = $('When Support Agent Votes on Escalation Poll').first().json;\nconst cfg = $('Poll State Configuration').first().json;\nconst idx = Array.isArray(ev.vote?.selectedOptionIndices) ? Number(ev.vote.selectedOptionIndices[0]) : -1;\nif (idx < 0 || idx > 2) return [];\nconst statuses = ['Human Assigned', 'Resolved', 'Refund Review'];\nreturn [{\n  json: {\n    phone: String(ticket.phone),\n    senderName: String(ticket.senderName || 'there'),\n    newStatus: statuses[idx],\n    notifyCustomerResolved: idx === 1,\n    spreadsheetId: cfg.spreadsheetId,\n  },\n}];"
      }
    },
